from collections import deque


def dfs(graph, start):
    visited = []
    stack = [start]
    while stack:
        v = stack.pop()
        if v not in visited:
            visited.append(v)
            for u in range(len(graph) - 1, -1, -1):
                if graph[v][u] == 1 and u not in visited:
                    stack.append(u)
    return visited


def bfs(graph, start):
    visited = [start]
    queue = deque([start])
    while queue:
        v = queue.popleft()
        for u in range(len(graph)):
            if graph[v][u] == 1 and u not in visited:
                visited.append(u)
                queue.append(u)
    return visited


def dijkstra(graph, start, finish):
    n = len(graph)
    INF = float('inf')
    dist = [INF] * n
    prev = [-1] * n
    visited = [False] * n
    dist[start] = 0
    for _ in range(n):
        v = -1
        for i in range(n):
            if not visited[i] and (v == -1 or dist[i] < dist[v]):
                v = i
        if dist[v] == INF:
            break
        visited[v] = True
        for u in range(n):
            if graph[v][u] > 0 and not visited[u]:
                if dist[v] + graph[v][u] < dist[u]:
                    dist[u] = dist[v] + graph[v][u]
                    prev[u] = v
    if dist[finish] == INF:
        return None, None
    path = []
    cur = finish
    while cur != -1:
        path.append(cur)
        cur = prev[cur]
    path.reverse()
    return dist[finish], path


def shortest_path_bfs(graph, start, finish):
    n = len(graph)
    prev = [-1] * n
    visited = [False] * n
    visited[start] = True
    queue = deque([start])
    while queue:
        v = queue.popleft()
        if v == finish:
            break
        for u in range(n):
            if graph[v][u] == 1 and not visited[u]:
                visited[u] = True
                prev[u] = v
                queue.append(u)
    if not visited[finish]:
        return None, None
    path = []
    cur = finish
    while cur != -1:
        path.append(cur)
        cur = prev[cur]
    path.reverse()
    return len(path) - 1, path


